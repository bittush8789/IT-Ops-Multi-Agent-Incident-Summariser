# IT-Ops Multi-Agent Incident Summariser - Environment Configuration Template
# Copy this file to .env and provide your local credentials for local development.

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Database Connection (PostgreSQL with pgvector)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/itops_incident_db

# Google Gemini LLM & Embeddings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# GitHub Integration
GITHUB_REPO=enterprise-org/payment-gateway
GITHUB_TOKEN=optional_github_personal_access_token
GITHUB_USE_MOCK=true
GITHUB_FIXTURE_PATH=tests/fixtures/github_changes.json

# Log Source Integration
LOG_SOURCE_TYPE=file
LOG_FIXTURE_PATH=tests/fixtures/incident_logs.json

# Workflow & Execution Budget
MAX_WORKFLOW_STEPS=12
AGENT_TIMEOUT_SECONDS=30
MAX_RETRIES=2

# Observability - Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_HOST=https://cloud.langfuse.com

# Observability - OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=itops-incident-summariser
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
